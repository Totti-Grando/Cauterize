# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit real keys.
# These are read from the environment by the adapters at runtime. You only need the keys for
# the backends you actually use (see --eval-backend / --target-backend).

# Provider-under-test (Gemini): key looks like AIza...
GEMINI_API_KEY=

# Evaluator LLM (Claude / Anthropic): key looks like sk-ant-...
ANTHROPIC_API_KEY=

# Groq (OpenAI-compatible), usable as evaluator and/or model-under-test: key looks like gsk_...
# --live defaults to the Groq backend. A gsk_... value is auto-detected from any slot.
GROQ_API_KEY=

# --- Amazon Bedrock evaluator (--eval-backend bedrock) ---
# Claude on Bedrock. Requires: pip install "anthropic[bedrock]"
# Credentials resolve via the standard AWS chain; set the region and ONE of the auth options.
AWS_REGION=us-west-2
# Option A: static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Option B: a named profile from ~/.aws/credentials (leave keys blank)
# AWS_PROFILE=
# Option C: a Bedrock bearer token
# AWS_BEARER_TOKEN_BEDROCK=

# --- Custom HTTP model-under-test (--target-backend http) ---
# Bearer token for the endpoint named by --target-api-key-env (e.g. RavenPack / a bank model).
# RAVENPACK_API_KEY=
